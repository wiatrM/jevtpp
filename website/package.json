{
  "name": "jevtpp-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:docs": "node scripts/prepare.mjs",
    "dev": "pnpm prepare:docs && astro dev --host 127.0.0.1",
    "build": "pnpm prepare:docs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.3",
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": { "parse5": "8.0.0" }
}
